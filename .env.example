# Copy to .env.local for local development. In production (Coolify), set
# this as a real environment variable on the resource instead.

# Base URL of the talentbes-api Go backend (see ../talentbes-api — a
# separate repo, deployed as its own Coolify resource). Used server-side
# only: for fetching public content (blogs/faqs/jobs/testimonials), the
# admin CMS's server-side proxy routes, and the "/uploads/[...path]" route
# that proxies uploaded files to the browser. Never sent to the browser (it
# has no NEXT_PUBLIC_ prefix), so the API's address never appears in
# client-side code or the browser's network tab, even though the API itself
# is also publicly reachable at its own domain.
#
# Local dev:
TALENTBES_API_URL=http://localhost:8080
# Production:
# TALENTBES_API_URL=https://api.talentbes.in
